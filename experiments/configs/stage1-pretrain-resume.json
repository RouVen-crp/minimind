{
  "stage": 1,
  "name": "pretrain-mini-one-epoch-resume",
  "environment": "minimind",
  "working_directory": "trainer",
  "command": "python train_pretrain.py --epochs 1 --from_resume 1",
  "script": "train_pretrain.py",
  "arguments": {
    "epochs": 1,
    "from_resume": 1,
    "save_dir": "../out",
    "save_weight": "pretrain",
    "batch_size": 32,
    "learning_rate": 0.0005,
    "device": "cuda:0",
    "dtype": "bfloat16",
    "num_workers": 8,
    "accumulation_steps": 8,
    "grad_clip": 1.0,
    "log_interval": 100,
    "save_interval": 1000,
    "hidden_size": 768,
    "num_hidden_layers": 8,
    "max_seq_len": 340,
    "use_moe": 0,
    "data_path": "../dataset/pretrain_t2t_mini.jsonl",
    "from_weight": "none",
    "seed": 42
  },
  "resume_checkpoint": {
    "path": "checkpoints/pretrain_768_resume.pth",
    "epoch_zero_based": 0,
    "step": 9000,
    "world_size": 1
  },
  "provenance_note": "The original foreground run used default epochs=2 and stopped after the step-9000 checkpoint. This tracked run resumes the same optimizer/model state and caps total training at one epoch."
}
